# Copy to .env and replace every "change-me" (JWT_SECRET: at least 32 random chars, e.g. `openssl rand -hex 32`).
POSTGRES_DB=tools
POSTGRES_USER=tools_app
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5433
API_HOST_PORT=3001
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# true lets anyone create a storekeeper account (needed for the demo); set false in production
ALLOW_REGISTRATION=true
SEED_DEMO=true
MANAGER_LOGIN=manager
MANAGER_PASSWORD=change-me
LOG_LEVEL=info
TZ=Europe/Moscow
