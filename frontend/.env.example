# Copy to .env (local) or set in the hosting project settings (Vercel: Settings -> Environment Variables).
# Both Supabase values are in the Supabase dashboard: Project Settings -> API.
# The anon key is public by design; never put the service_role key or the database password here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX). Without it analytics is switched off completely.
# The tag is loaded only after the visitor agrees in the consent banner.
VITE_GA_MEASUREMENT_ID=
